    void applyDeckStemMix(SongDeck& deck,double rampSeconds){
        const auto anySolo=std::any_of(deck.stemSolo.begin(),deck.stemSolo.end(),[](bool value){return value;});
        for(size_t index=0;index<deck.stemGains.size();++index){const auto audible=!deck.stemMuted[index]&&(!anySolo||deck.stemSolo[index]);deck.stemGains[index]->setGain(audible?mixerFaderToGain(deck.stemFaders[index])*mixerFaderToGain(musicBusGain)*deck.normalizationGain*panicAttenuation:0.0f,rampSeconds);}
    }
